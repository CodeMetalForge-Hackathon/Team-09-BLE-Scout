# Copy to pi/.env and fill in. .env is never committed.
# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The PUBLIC anon / publishable key (the same one built into the iPhone app).
# Never put the secret / service_role key on the Pi: it can read every row.
SUPABASE_ANON_KEY=sb_publishable_D0iLyws3swx-NQGb4QA5Ew_0ZKFZLzY

# Phones and the ground station must use the same team code.
TEAM_CODE=TEAM9

# How this Pi appears in the database and on the ground station.
PI_NAME=Raspberry Pi
PI_ID=pi-1

# Upload every 2 seconds; ignore readings weaker than -95 dBm.
PI_INTERVAL=2
PI_MIN_RSSI=-95
