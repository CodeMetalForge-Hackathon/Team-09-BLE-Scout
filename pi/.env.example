# Copy to pi/.env and fill in. .env is never committed.
# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The PUBLIC anon / publishable key (the same one built into the iPhone app).
# Never put the secret / service_role key on the Pi: it can read every row.
SUPABASE_ANON_KEY=sb_publishable_D0iLyws3swx-NQGb4QA5Ew_0ZKFZLzY

# Phones and the ground station must use the same team code.
TEAM_CODE=TEAM9

# How this Pi appears in the database and on the ground station.
PI_NAME=Raspberry Pi
PI_ID=pi-1

# Upload every 2 seconds; ignore readings weaker than -95 dBm.
# Hot-spot placement further ignores readings below -90 dBm.
PI_INTERVAL=2
PI_MIN_RSSI=-95

# Camera movement (Raspberry Pi AI Camera facing up at the ceiling).
# Set PI_CAMERA=0 to upload Bluetooth only.
PI_CAMERA=1
PI_CAMERA_FACING=up
# Distance from the lens to the ceiling in metres (ceiling height - Pi height).
PI_CAMERA_DISTANCE_M=2.0
# Rotate frames if the camera is mounted upside-down or sideways.
PI_CAMERA_ROTATE=0
PI_CAMERA_RES=640x480
PI_CAMERA_FPS=15
# 4.74 mm lens, 1.55 um pixels -> about 485 px at 640x480.
PI_CAMERA_FOCAL_PX=485
# Increase if a measured 1 m walk reports less than 1 m (and vice versa).
PI_CAMERA_SCALE=1.0
# Flip these if the path goes the wrong way on the dashboard.
PI_CAMERA_FLIP_X=0
PI_CAMERA_FLIP_Y=0
PI_CAMERA_YAW_SIGN=-1
