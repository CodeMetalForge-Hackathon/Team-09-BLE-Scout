# Copy to .env (same folder) and fill in. .env is never committed.
# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The SECRET key (service_role / sb_secret_...). Keep it private: it can read all rows.
SUPABASE_SERVICE_KEY=YOUR-SECRET-KEY
# Phones must use the same team code (BLE Scout → 📡 settings).
TEAM_CODE=TEAM9
# Only for fake_phones.py --cloud (the same public key that's built into the app)
SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY
